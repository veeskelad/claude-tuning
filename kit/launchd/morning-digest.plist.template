<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Шаблон: каждое утро в 07:00 собирает ~/.claude/morning-digest.md из сводок сессий (скилл
	     claude-session-bridge): блокеры, задачи со следующим шагом, открытые чек-листы. Модель не зовётся.
	     Показывает её первая сессия дня (хук SessionStart, daily_digest.py show).
	     Компьютер спал в 07:00 — launchd запустит задачу при пробуждении.
	     В шаблоне два плейсхолдера: домашняя папка (абсолютный путь) и префикс метки (обратный домен).
	     install-kit.py подставляет их сам. Вручную: заменить оба через sed, сохранить как
	     ~/Library/LaunchAgents/<префикс>.morning-digest.plist и включить командой launchctl load.
	     Выключить: launchctl unload и удалить файл.
	     Linux, строка для crontab -e:
	     0 7 * * * python3 "$HOME/.agents/skills/claude-session-bridge/scripts/daily_digest.py" morning -->
	<key>Label</key>
	<string>__LABEL_PREFIX__.morning-digest</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>-lc</string>
		<string>f="$HOME/.agents/skills/claude-session-bridge/scripts/daily_digest.py"; [ -r "$f" ] || exit 0; exec python3 "$f" morning</string>
	</array>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>7</integer>
		<key>Minute</key>
		<integer>0</integer>
	</dict>
	<key>RunAtLoad</key>
	<false/>
	<key>Nice</key>
	<integer>10</integer>
	<key>LowPriorityIO</key>
	<true/>
	<key>StandardOutPath</key>
	<string>__HOME__/Library/Logs/__LABEL_PREFIX__.morning-digest.log</string>
	<key>StandardErrorPath</key>
	<string>__HOME__/Library/Logs/__LABEL_PREFIX__.morning-digest.log</string>
</dict>
</plist>
