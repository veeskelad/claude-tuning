<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Шаблон: раз в день в 10:40 запускает скрипт уборки мусора из папки bin в ~/.claude.
	     В шаблоне два плейсхолдера: домашняя папка (абсолютный путь) и префикс метки (обратный домен).
	     install-kit.py подставляет их сам. Вручную: заменить оба через sed, сохранить как
	     ~/Library/LaunchAgents/<префикс>.claude-junk-clean.plist и включить командой launchctl load.
	     Выключить: launchctl unload и удалить файл. -->
	<key>Label</key>
	<string>__LABEL_PREFIX__.claude-junk-clean</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>-lc</string>
		<string>__HOME__/.claude/bin/claude-junk-clean.sh</string>
	</array>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>10</integer>
		<key>Minute</key>
		<integer>40</integer>
	</dict>
	<key>RunAtLoad</key>
	<false/>
	<key>Nice</key>
	<integer>10</integer>
	<key>LowPriorityIO</key>
	<true/>
	<key>StandardOutPath</key>
	<string>__HOME__/Library/Logs/__LABEL_PREFIX__.claude-junk-clean.log</string>
	<key>StandardErrorPath</key>
	<string>__HOME__/Library/Logs/__LABEL_PREFIX__.claude-junk-clean.log</string>
</dict>
</plist>
